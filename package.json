{
  "name": "velocious-search",
  "version": "0.1.0",
  "description": "Reusable relationship-aware filtering for Velocious applications.",
  "type": "module",
  "exports": {
    "./apply-search": {
      "types": "./build/apply-search.d.ts",
      "default": "./build/apply-search.js"
    },
    "./filter-contract": {
      "types": "./build/filter-contract.d.ts",
      "default": "./build/filter-contract.js"
    },
    "./search-catalog": {
      "types": "./build/search-catalog.d.ts",
      "default": "./build/search-catalog.js"
    },
    "./search-filter": {
      "types": "./build/components/search-filter.d.ts",
      "default": "./build/components/search-filter.js"
    },
    "./searchable-resource": {
      "types": "./build/searchable-resource.d.ts",
      "default": "./build/searchable-resource.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/**",
    "docs/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "all-checks": "npm run lint && npm run build && npm test && npm test -- spec/package-entrypoints-check.js",
    "build": "node scripts/clean-build.js && npm run compile",
    "compile": "tsc --project tsconfig.frontend.json && tsc --project tsconfig.backend.json",
    "eslint": "eslint --max-warnings 0 .",
    "lint": "npm run eslint && npm run typecheck",
    "prepack": "npm run build",
    "release:patch": "release-patch",
    "test": "TSX_TSCONFIG_PATH=tsconfig.frontend.json node --import tsx --import ./spec/react-test-runtime.js ./node_modules/jasmine/bin/jasmine.js",
    "test:package-entrypoints": "npm run build && npm test -- spec/package-entrypoints-check.js",
    "typecheck": "tsc --project tsconfig.frontend.json --noEmit && tsc --project tsconfig.backend.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaspernj/velocious-search.git"
  },
  "homepage": "https://github.com/kaspernj/velocious-search#readme",
  "bugs": {
    "url": "https://github.com/kaspernj/velocious-search/issues"
  },
  "license": "ISC",
  "author": "kasper@diestoeckels.de",
  "dependencies": {
    "prop-types": "^15.8.1",
    "prop-types-exact": "^1.2.7",
    "react-native-propforge": "^1.0.7",
    "set-state-compare": "^1.0.86",
    "typanic": "^1.0.10"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.76.0",
    "velocious": ">=1.0.609"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/jasmine": "^6.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^64.0.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.0.0",
    "jasmine": "^6.0.0",
    "jsdom": "^29.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-web": "^0.21.2",
    "release-patch": "^1.0.0",
    "selenium-webdriver": "^4.39.0",
    "system-testing": "^1.0.130",
    "tsx": "^4.23.12",
    "typescript": "6.0.3",
    "velocious": "^1.0.609"
  }
}
